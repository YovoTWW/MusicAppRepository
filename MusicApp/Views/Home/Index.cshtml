@using MusicApp.ViewModels
@using static MusicApp.Constants.Genres;

@model IEnumerable<BasicSongViewModel>

@{
    string searchTextName = ViewData["SearchTextName"] as string ?? string.Empty;
    string searchTextCreator = ViewData["SearchTextCreator"] as string ?? string.Empty;
    ViewData["Title"] = "Songs List";
}

<link rel="stylesheet" href="~/css/card.css" asp-append-version="true" />

<div>
    <button><a asp-controller="Home" asp-action="Add" title="Add a new song" class="btn btn-info">Add a new Song</a></button>
</div>
<br />

<form method="get" class="mb-4" id="filters">
    <div class="row mb-2">
        <div class="col">
            <input type="text"
                   name="searchTextName"
                   class="form-control"
                   placeholder="Filter by Title"
                   value="@searchTextName">
        </div>
    </div>

    <div class="row mb-2">
        <div class="col">
            <input type="text"
                   name="searchTextCreator"
                   class="form-control"
                   placeholder="Filter by Creator"
                   value="@searchTextCreator">
        </div>
    </div>

    <div class="row mb-2">
        <div class="col">
            <input type="number"
                   step="1" min="0"
                   name="YearFilters"
                   class="form-control"
                   placeholder="Filter by Rlease Year"
                   value="@ViewData["YearFilters"]" />
        </div>
    </div>

    <div class="mb-2">
        <h5>Genres</h5>
        @{
            var genres = MusicGenres;      
        }
        
        @foreach (var genre in genres)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="checkbox"
                       name="GenreFilters"
                       value="@genre"
                       id="genre_@genre"
                @(ViewData["GenreFilters"] is List<string> selectedGenres && selectedGenres.Contains(genre) ? "checked" : "") />

                <label class="form-check-label" for="genre_@genre">@genre</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary mt-2">
        Apply Filters
    </button>
</form>

<hr />

<div class="Song-Row">
    @foreach (var song in Model)
    {
        <div class="Song-Box">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title">@song.Title</h2>

                    <p class="card-text">
                        <strong>Artist:</strong> @song.Creator
                    </p>

                    <p class="card-text">
                        <strong>Genre:</strong> @song.Genre
                    </p>

                    <p class="card-text">
                        <strong>Year:</strong> @song.YearReleased
                    </p>

                    <p class="card-text">
                        <strong>Duration:</strong> @(song.Duration / 60)m @(song.Duration % 60)s
                    </p>

                    <div class="Buttons-Div">
                        <a href="@song.WikiURL"
                           class="btn btn-info"
                           title="Open the song Wikipedia page"
                           onclick="return checkUrl(@Html.Raw(Json.Serialize(song.WikiURL)))">
                            <img class="icon-image" src="~/images/wikipedia-logo.png">
                        </a>
                        <a href="@song.PlayURL"
                           class="btn btn-info"
                           title="Open the song Youtube link"
                           onclick="return checkUrl(@Html.Raw(Json.Serialize(song.PlayURL)))">
                            <img class="icon-image" src="~/images/youtube-logo.png">
                        </a>
                        <a asp-controller="Home"
                           asp-action="Edit"
                           asp-route-id="@song.Id"
                           title="Edit the information about the song"
                           class="btn btn-info">
                            Edit
                        </a>
                        <a asp-controller="Home"
                           asp-action="Delete"
                           asp-route-id="@song.Id"
                           title="Delete the information about the song"
                           class="btn btn-info">
                            Delete
                        </a>
                    </div>
                </div>
                <div class="card-image">
                @if (!string.IsNullOrEmpty(song.ImageURL))
                {
                    <img src="@song.ImageURL" class="song-image" alt="No Image Available">
                }
                else
                {
                     <img src="~/img/no-image-available-02.jpg" class="song-image"  alt="No Image Available">
                }
                </div>
            </div>
        </div>
    }
</div>

<script>
    function checkUrl(url) {
        if (!url || url.trim() === "") {
            alert("No URL available for this song.");
            return false; 
        }
        return true; 
    }
</script>