@using MusicApp.ViewModels;
@model DeleteSongViewModel;
@{
    ViewData["Title"] = "Delete Song";
}

<div class="d-flex justify-content-between align-items-center mb-3" style="margin-top: 20px;"> 
    <h2>@ViewData["Title"]</h2>
</div>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                <h3 class="card-title text-center">@Model.Title</h3>
                <p class="text-danger mt-3">Are you sure you want to delete @(Model.Title)?</p>
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Title" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a asp-controller="Home" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
