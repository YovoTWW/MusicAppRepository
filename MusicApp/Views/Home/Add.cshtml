@using MusicApp.ViewModels;
@model AddSongViewModel;
@{
    ViewData["Title"] = "Add Song";    
}


<div class="row">
    <div class="col-sm-12 offset-lg-2 col-lg-8 offset-xl-3 col-xl-6">
      
            <form asp-action="Add" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-sm-6 mb-2">
                        <label asp-for="@Model.Title" class="form-label-add-edit">Song Title</label>
                        <input asp-for="@Model.Title" class="form-control" aria-required="true" />
                        <span asp-validation-for="@Model.Title" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <label asp-for="@Model.Duration" class="form-label-add-edit">Duration</label>
                        <div class="input-group">
                            <span class="input-group-text">(seconds)</span>
                            <input asp-for="Duration" class="form-control" aria-required="true" type="number" step="1" min="1" />
                        </div>
                        <span asp-validation-for="@Model.Duration" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-2">
                    <label asp-for="@Model.Creator" class="form-label-add-edit">Creator</label>
                    <input asp-for="@Model.Creator" class="form-control" aria-required="true" />
                    <span asp-validation-for="@Model.Creator" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="@Model.ImageURL" class="form-label-add-edit">ImageURL</label>
                    <input asp-for="@Model.ImageURL" class="form-control" aria-required="false" placeholder="Enter image URL (optional)" />
                    <span asp-validation-for="@Model.ImageURL" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-sm-6 mb-2">
                        <label asp-for="Genre" class="form-label-add-edit">Genre</label>
                        <select asp-for="Genre" class="form-select" aria-required="true">
                            <option value="">Select a Genre for the Song</option>
                            @foreach (var Genre in Model.GenreList)
                            {
                                <option value="@Genre" Model.Category=Genre>@Genre</option>
                            }
                        </select>
                        <span asp-validation-for="Genre" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 mb-2">
                        <label asp-for="@Model.YearReleased" class="form-label-add-edit">Release Year</label>
                        <div class="input-group">
                            <input asp-for="YearReleased" class="form-control" aria-required="true" type="number" step="1" min="0" />
                        </div>
                        <span asp-validation-for="@Model.YearReleased" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-2">
                    <input class="btn btn-warning btn-dark-text w-100 py-2 fw-bold rounded" type="submit" value="Save" />
                </div>
            </form>
        
    </div>
</div> 